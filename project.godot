; Engine configuration file.
; Godot 4.7 で作成。設定の意味は docs/project_settings.md を参照。

config_version=5

[application]

config/name="HackSla"
config/description="2Dドット絵・斜め見下ろし視点のハクスラ（プロトタイプ）"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

InputSetup="*res://scripts/core/input_setup.gd"
DataDB="*res://scripts/data/data_db.gd"
DebugOverlay="*res://scripts/debug/debug_overlay.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.09, 1)
